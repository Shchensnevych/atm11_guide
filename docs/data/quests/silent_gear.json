ні форми&r і &c&lливарня&r. \n\nЩоб почати будувати &c&lливарню&r, почніть із &cвогнетривкої глини&r.","flex":true,"tasks":[{"id":"43D3130D29D092F0","type":"item","item":"productivemetalworks:fire_clay","icon":"productivemetalworks:fire_clay","name":"Вогнетривка глина"}],"shape":"gear","size":2.0,"icon":"productivemetalworks:fire_clay","rewards":1,"rw":[{"t":"item","item":"productivemetalworks:fire_clay","n":8,"name":"Вогнетривка глина"}]},{"id":"45899579D9B92D91","x":1.5,"title":"Контролер ливарні","desc":"&aКонтролер&r — серце &c&lливарні&r. \n\nКожній &c&lливарні&r потрібен щонайменше 1 контролер. \n\nЧерез контролер &c&lливарні&r можна відкрити інтерфейс &c&lливарні&r. Там видно кількість рідин у &c&lливарні&r. \n\nТакож через нього можна класти предмети в &c&lливарню&r і забирати їх.","deps":["6BBC440BD0AD0E93"],"flex":true,"tasks":[{"id":"7D9F2C8E7C65B654","type":"item","item":"productivemetalworks:black_foundry_controller","icon":"productivemetalworks:black_foundry_controller","name":"Чорний контролер ливарні"}],"shape":"hexagon","size":1.0,"icon":"productivemetalworks:black_foundry_controller","rewards":1,"rw":[{"t":"item","item":"minecraft:iron_ore","n":5,"name":"Залізна руда"}]},{"id":"036D5767E07005BC","x":1.5,"y":-1.0,"title":"Зливи ливарні","desc":"&bЗливи&r потрібні, щоб видобувати &7рідкі метали&r. Так, на жаль, вони надто гарячі для рук чи відер. \n\nПриєднайте &7кран&r &c&lливарні&r до &bзливу&r, щоб зливати &7рідкі метали&r, клацнувши ПКМ по крану. \n\nА ще, дивлячись на &bзлив&r, можна побачити кількість рідин у &c&lливарні&r!","deps":["6BBC440BD0AD0E93"],"flex":true,"tasks":[{"id":"54EF988F476C9208","type":"item","item":"productivemetalworks:black_foundry_drain","icon":"productivemetalworks:black_foundry_drain","name":"Чорний злив ливарні"}],"shape":"hexagon","size":1.0,"icon":"productivemetalworks:black_foundry_drain","rewards":1,"rw":[{"t":"item","item":"productivemetalworks:foundry_tap","n":1,"name":"Кран ливарні"}]},{"id":"2156C00E30424844","x":1.5,"y":1.0,"title":"Резервуари ливарні","desc":"&4Резервуари&r потрібні, щоб додавати рідини в &c&lливарню&r. \n\nПереважно паливо. \n\nПереважно &cлаву&r! \n\nСхоже, це один із небагатьох способів справді заправити &c&lливарню&r.","deps":["6BBC440BD0AD0E93"],"flex":true,"tasks":[{"id":"155D4ED18738E127","type":"item","item":"productivemetalworks:black_foundry_tank","icon":"productivemetalworks:black_foundry_tank","name":"Чорний резервуар ливарні"}],"shape":"hexagon","size":1.0,"icon":"productivemetalworks:black_foundry_tank","rewards":1,"rw":[{"t":"item","item":"minecraft:lava_bucket","n":2,"name":"Відро лави"}]},{"id":"061A51A0EC13CA0F","x":3.5,"title":"Будуємо ливарню","desc":"Тепер, коли є &aконтролер&r, &bзливи&r і &4резервуари&r, знадобиться ще кілька блоків. \n\nПо-перше, &6рідинні нагрівальні спіралі&r. З них складається підлога &c&lливарні&r, і вони потрібні, щоб нагрівати &c&lливарню&r. \n\nІ нарешті — або вікна &c&lливарні&r, або &cвогнетривка цегла&r. З них будуємо решту споруди! Буквально будівельні блоки. \n\nКаркас &c&lливарні&r будувати не треба, тож кути можуть лишатися порожніми; але для завершення потрібні 4 стіни й підлога. Якщо якогось блока бракує, &aконтролер&r підкаже, де саме. \n\n&c&lЛиварня&r може бути завбільшки всього 1x1 усередині, якщо має &aконтролер&r, &6рідинні нагрівальні спіралі&r і заповнені інші стіни! \n\nПроте таку маленьку робити не раджу: що більша &c&lливарня&r, то більше в ній місця! \n\nВи зрозумієте, що &c&lливарню&r збудовано, коли &aконтролер&r засвітиться, як піч, а &6рідинні нагрівальні спіралі&r стануть &6помаранчевими&r.","deps":["6BBC440BD0AD0E93","036D5767E07005BC","45899579D9B92D91","2156C00E30424844"],"flex":true,"tasks":[{"id":"7EA926887C3C4DF1","type":"item","item":"productivemetalworks:liquid_heating_coil","icon":"productivemetalworks:liquid_heating_coil","name":"Рідинна нагрівальна спіраль"},{"id":"2AE89914A34BF3AD","type":"item","item":"ftbfiltersystem:smart_filter","icon":"productivemetalworks:black_foundry_window","opts":[{"id":"productivemetalworks:black_foundry_window","name":"Чорне вікно ливарні"},{"id":"productivemetalworks:black_fire_bricks","name":"Чорна вогнетривка цегла"}],"name":"Вогнетривка цегла або вікна ливарні"}],"shape":"octagon","size":2.0,"icon":"productivemetalworks:liquid_heating_coil","rewards":2,"rw":[{"t":"item","item":"productivemetalworks:liquid_heating_coil","n":4,"name":"Рідинна нагрівальна спіраль"},{"t":"item","item":"productivemetalworks:fire_brick","n":16,"name":"Вогнетривка цегла"}]},{"id":"26F9DB31A835B69C","x":5.0,"title":"Відливаємо предмети","desc":"&nЛиварня&r: &aє&r \n&nРідкий метал у ливарні&r: &aє&r \n\nА як його тепер дістати? \n\nПам'ятаєте нашого давнього друга — &bзлив&r &c&lливарні&r? Треба познайомити його з новим другом — &7краном&r &c&lливарні&r. \n\nПоставте &7кран&r &c&lливарні&r на &bзлив&r — тепер під ним можна ставити блоки, у які зливатиметься &7рідкий метал&r… \n\nНаприклад, &8ливарний чан&r, який перетворить близько 900mB &7рідкого металу&r на цілий &7блок металу&r. \n\nАбо &8ливарний стіл&r, який нам знадобиться, щоб зробити…","deps":["061A51A0EC13CA0F"],"flex":true,"tasks":[{"id":"1298FA0C01851C12","type":"item","item":"productivemetalworks:casting_table","icon":"productivemetalworks:casting_table","name":"Ливарний стіл"},{"id":"795DA8AF99CBCA50","type":"item","item":"productivemetalworks:casting_basin","icon":"productivemetalworks:casting_basin","name":"Ливарний чан"},{"id":"6987EEE62166C628","type":"item","item":"productivemetalworks:foundry_tap","icon":"productivemetalworks:foundry_tap","name":"Кран ливарні"}],"shape":"hexagon","size":1.0,"icon":"productivemetalworks:casting_table","rewards":2,"rw":[{"t":"item","item":"productivemetalworks:fire_brick","n":10,"name":"Вогнетривка цегла"},{"t":"item","item":"minecraft:lava_bucket","n":2,"name":"Відро лави"}]},{"id":"711826BBCA832EE2","x":7.0,"title":"Ливарні форми","desc":"Усі &8ливарні форми&r створені рівними. Тобто, я маю на увазі, їх роблять однаково. \n\nЗаливаючи &8сталь&r на предмет на &8ливарному столі&r! \n\nЯк зробити &8сталь&r, питаєте? Просто розплавте будь-які &8сталеві&r предмети чи злитки. Або сплавте 9 &7заліза&r з 10 &0вугілля&r. \n\nСплавлення відбувається, коли &c&lливарня&r &6нагріта&r і в ній є потрібна кількість різних &7рідких металів&r. Ці два &7рідкі метали&r об'єднаються в один &7рідкий метал&r!","deps":["26F9DB31A835B69C"],"flex":true,"tasks":[{"id":"2A07AF6A43DCEA8C","type":"item","item":"minecraft:iron_ingot","icon":"minecraft:iron_ingot","name":"Залізний злиток"},{"id":"704D0B6CBDB29691","type":"item","item":"minecraft:coal","icon":"minecraft:coal","name":"Вугілля"}],"shape":"square","size":2.5,"icon":"productivemetalworks:ingot_cast","rewards":2,"rw":[{"t":"item","item":"minecraft:iron_ingot","n":9,"name":"Залізний злиток"},{"t":"item","item":"minecraft:coal","n":10,"name":"Вугілля"}],"hdtl":true},{"id":"474AF9F90C8E40A2","x":6.5,"y":-4.5,"deps":["711826BBCA832EE2"],"flex":true,"tasks":[{"id":"07BB99888347C53D","type":"item","item":"silentgear:mace_blueprint","icon":"silentgear:mace_blueprint"}],"shape":"none","size":1.4,"icon":"silentgear:mace_blueprint","rewards":3,"rw":[{"t":"item","item":"minecraft:iron_ingot","n":3,"name":"Залізний злиток"},{"t":"item","item":"minecraft:coal","n":4,"name":"Вугілля"},{"t":"xp","n":100}]},{"id":"36A5229DB5D4C059","x":6.0,"y":2.5,"title":"Форма для злитка","deps":["711826BBCA832EE2"],"flex":true,"tasks":[{"id":"7C9C82BDC24D84DE","type":"item","item":"productivemetalworks:ingot_cast","icon":"productivemetalworks:ingot_cast","name":"Форма для злитка"}],"shape":"none","size":1.4,"icon":"productivemetalworks:ingot_cast","rewards":3,"rw":[{"t":"item","item":"minecraft:iron_ingot","n":3,"name":"Залізний злиток"},{"t":"item","item":"minecraft:coal","n":4,"name":"Вугілля"},{"t":"xp","n":100}]},{"id":"0251715AB65D8151","x":6.5,"y":3.5,"title":"Форма для дорогоцінного каменю","deps":["711826BBCA832EE2"],"flex":true,"tasks":[{"id":"0B1433A7B1F7E628","type":"ite