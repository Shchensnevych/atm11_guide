gn:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:dahlia","name":"Жоржина"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"2F1B74D45E50A079","x":10.5,"y":-5.0,"title":"Лобелія велика","sub":"Ультрамарин","desc":"{image:atm:textures/questpics/pro_farming/farm_lobelia.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:great_lobelia","name":"Лобелія велика"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"523AD3D448DE58A6","x":7.0,"y":-4.0,"title":"Морозник","sub":"Сірий","desc":"{image:atm:textures/questpics/pro_farming/farm_hellebore.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:hellebore","name":"Морозник"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"7514CF65A077985E","x":8.0,"y":-4.0,"title":"Гімалайський мак","sub":"Блакитний","desc":"{image:atm:textures/questpics/pro_farming/farm_himalayan.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:himalayan_poppy","name":"Гімалайський мак"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"60521AAE8BAA32C5","x":9.0,"y":-4.0,"title":"Гортензія","sub":"Рожевий","desc":"{image:atm:textures/questpics/pro_farming/farm_hydrangea.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:hydrangea","name":"Гортензія"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"7EF3DB8B5258FA34","x":10.0,"y":-4.0,"title":"Пустирник","sub":"Персиковий","desc":"{image:atm:textures/questpics/pro_farming/farm_motherwort.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:motherwort","name":"Пустирник"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"2DB404AA2832F81D","x":6.5,"y":-3.0,"title":"Миколайчики приморські","sub":"Синій","desc":"{image:atm:textures/questpics/pro_farming/farm_holly.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:sea_holly","name":"Миколайчики приморські"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"42AE629EBAA3AA94","x":7.5,"y":-3.0,"title":"Шоломниця","sub":"Фіолетовий","desc":"{image:atm:textures/questpics/pro_farming/farm_skullcap.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:skullcap","name":"Шоломниця"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"5854DA8F791AD71F","x":8.5,"y":-3.0,"title":"Кропива жалка","sub":"Зелений","desc":"{image:atm:textures/questpics/pro_farming/farm_nettle.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:stinging_nettle","name":"Кропива жалка"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"739C0DB291B1563C","x":9.5,"y":-3.0,"title":"Корінь валеріани","sub":"Білий","desc":"{image:atm:textures/questpics/pro_farming/farm_valerian.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:valerian_root","name":"Корінь валеріани"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"6479A38086A43E49","x":10.5,"y":-3.0,"title":"Цинія","sub":"Бурштиновий","desc":"{image:atm:textures/questpics/pro_farming/farm_zinnia.png width:100 height:150 align:center}","deps":["4B5FCDD5FC705903"],"tasks":[{"type":"item","item":"productivefarming:zinnia","name":"Цинія"}],"shape":"hexagon","size":1.25,"rewards":1},{"id":"743E6D3BC306059F","x":-10.5,"y":16.5,"title":"Маранта","deps":["699F91BC5CA58FE2"],"tasks":[{"type":"item","item":"productivefarming:arrowroot","name":"Маранта"}],"size":1.0,"optional":true,"rewards":1},{"id":"661489455FA28131","x":-1.5,"y":3.5,"title":"Рукола","deps":["699F91BC5CA58FE2"],"tasks":[{"type":"item","item":"productivefarming:arugula","name":"Рукола"}],"size":1.0,"optional":true,"rewards":1},{"id":"2CFD0DF119CC5E85","x":-0.5,"y":-12.0,"title":"Будуємо","desc":"Тепер переходимо до будівництва. Спершу — вибір блоків. \n\nВи можете побачити величезний список блоків, якими можна виконати квест: це всі блоки, з яких може складатися &a&lспоруда&r. \n\n(По суті, будь-яка цегла і скло). Блоки можна змішувати як завгодно — споруда не перебірлива! \n\nСама &a&lспоруда&r — це лише стіни й внутрішній простір. Стіни мають бути з цих блоків, а внутрішній простір не має перевищувати певного об'єму в блоках. \n\nНайменша &a&lавтоферма&r — 2x2. Найбільша — така, щоб внутрішній об'єм не перевищував 200 блоків. Я кажу «об'єм», бо площа рахується заввишки 2 блоки, щоб урахувати й самі культури. Тобто внутрішня площа 10x10 — це максимальний розмір. \n\nУсередині буде ваша &2рілля&r, &9вода&r чи що там ще потрібно для посадки. &2Ріллі&r все одно потрібна &9вода&r для зволоження (раджу &9блок води&r з XyCraft). \n\nДобрива чи прискорювачі росту біля &2культур &fабо на &2ріллі&r так само пришвидшать ріст!\n{image:atm:textures/questpics/pro_farming/farm_autofarm.png width:150 height:100 align:center}","deps":["2AFB12E742596864"],"tasks":[{"type":"item","item":"ftbfiltersystem:smart_filter","name":"Блоки ферми"}],"shape":"diamond","size":1.25,"rewards":1},{"id":"488BC7224CAC720C","x":-3.5,"y":7.5,"title":"Зелений болгарський перець","deps":["699F91BC5CA58FE2"],"tasks":[{"type":"item","item":"productivefarming:green_bell_pepper","name":"Зелений болгарський перець"}],"size":1.0,"rewards":2},{"id":"0E96B2A9B7FD39CD","x":-3.5,"y":13.5,"title":"Жовтий болгарський перець","deps":["699F91BC5CA58FE2"],"tasks":[{"type":"item","item":"productivefarming:yellow_bell_pepper","name":"Жовтий болгарський перець"}],"size":1.0,"rewards":2},{"id":"18A9E8789E1B560F","x":-3.5,"y":9.5,"title":"Червоний болгарський перець","deps":["699F91BC5CA58FE2"],"tasks":[{"type":"item","item":"productivefarming:red_bell_pepper","name":"Червоний болгарський перець"}],"size":1.0,"rewards":2},{"id":"167