  {"id": "key.curios.open.desc", "to": "Shift+Миша 4", "why": "аксесуари поруч із ранцем на кнопці миші 4; G — меню предметів модів", "was": "G"},
  {"id": "key.toolbelt.slot", "to": "Ctrl+V", "why": "вікно слота пояса — рідко; V — рушій жетпака й інші предмети", "was": "V"},
