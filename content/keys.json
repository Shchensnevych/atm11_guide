  {"id": "keybind.ironjetpacks.engine", "to": "Ctrl+Миша 4", "why": "рушій жетпака — на миші, щоб вмикати в польоті; V — інші предмети", "was": "V"},
  {"id": "key.jade.show_overlay", "to": "Ins", "why": "на TKL немає цифрового блока (Num 1); Ins — показати / сховати підказку Jade", "was": "Num 1"},
